  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "vitest run tests/acceptance/agent/acceptance.test.ts",
    "test:e2e": "playwright test",
