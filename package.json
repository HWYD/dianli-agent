    "@langchain/core": "^1.2.9",
    "ai": "^7.0.77",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
